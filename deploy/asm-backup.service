[Unit]
Description=Verified private backup of ASM TODO workspaces
After=asm-canary.service

[Service]
Type=oneshot
WorkingDirectory=/var/lib/asm-todo
ExecStart=/srv/canary/asm.micutu.com/app/bin/backup /var/lib/asm-todo/data /var/backups/asm-todo
TimeoutStartSec=10min
LimitCORE=0
User=root
UMask=0077
Nice=10
MemoryMax=128M
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ReadOnlyPaths=/var/lib/asm-todo/data
ReadWritePaths=/var/backups/asm-todo
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX

CapabilityBoundingSet=CAP_DAC_READ_SEARCH
AmbientCapabilities=
MemoryDenyWriteExecute=yes
ProtectProc=invisible
ProcSubset=pid
SystemCallArchitectures=native
SystemCallFilter=read write open openat close fstat fchmod umask getdents64 getrandom flock fsync renameat2 unlinkat time mkdir prctl execve execveat exit exit_group
SystemCallErrorNumber=EPERM
IPAddressDeny=any
