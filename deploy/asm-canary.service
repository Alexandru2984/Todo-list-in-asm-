[Unit]
Description=ASM TODO task workspace
After=network.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=asm-todo
Group=asm-todo
StateDirectory=asm-todo
StateDirectoryMode=0700
WorkingDirectory=/var/lib/asm-todo
ExecStart=/srv/canary/asm.micutu.com/app/bin/server 34624
Restart=on-failure
RestartSec=2
TimeoutStopSec=20
KillMode=control-group
MemoryHigh=160M
MemoryMax=256M
TasksMax=32
LimitNOFILE=64
LimitCORE=0
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/asm-todo
ProtectClock=yes
ProtectKernelLogs=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectProc=invisible
ProcSubset=pid
RestrictSUIDSGID=yes
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=read write open close fstat ftruncate mkdir socket setsockopt bind listen accept fork exit rt_sigaction alarm getrandom flock fsync rename time execve execveat exit_group
SystemCallErrorNumber=EPERM
RestrictAddressFamilies=AF_INET
IPAddressDeny=any
IPAddressAllow=localhost
CapabilityBoundingSet=
AmbientCapabilities=
RemoveIPC=yes

[Install]
WantedBy=multi-user.target
